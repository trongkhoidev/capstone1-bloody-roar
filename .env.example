# =============================================================================
# Bloody-Roar — Environment Variables Template
# Copy this file to .env and fill in the values
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# PostgreSQL connection string
# Local dev: uses Docker Compose (see docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/bloody_roar_dev?schema=public"
# Supabase direct connection for Prisma migrations (uses port 5432 or local port)
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/bloody_roar_dev?schema=public"

# -----------------------------------------------------------------------------
# AUTH — Thirdweb (SIWE — Sign In With Ethereum)
# https://thirdweb.com/dashboard/settings/api-keys
# -----------------------------------------------------------------------------
THIRDWEB_SECRET_KEY=""
THIRDWEB_CLIENT_ID=""

# Private key for signing Thirdweb Auth JWTs (dedicated key, NOT the deployer key)
# In dev: use any Hardhat account key (e.g. account #1)
# In prod: generate a fresh key and keep it separate from DEPLOYER_PRIVATE_KEY
AUTH_PRIVATE_KEY=""

# -----------------------------------------------------------------------------
# AI — model router (self-hosted OpenAI-compatible endpoint → Groq → OpenAI)
# The hosted providers are temporary; no model training is performed.
# A local endpoint such as Ollama can be set in AI_BASE_URL.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=""
OPENAI_MODEL_GUARD="gpt-4.1-mini"
OPENAI_MODEL_TESTGEN="gpt-4.1-mini"
OPENAI_MODEL_DEBATE="gpt-4.1-mini"

# -----------------------------------------------------------------------------
# AI — Groq (Free tier: 14,400 req/day)
# https://console.groq.com/keys
# -----------------------------------------------------------------------------
GROQ_API_KEY=""
GROQ_MODEL_GUARD="openai/gpt-oss-20b"
GROQ_MODEL_TESTGEN="openai/gpt-oss-120b"
GROQ_MODEL_DEBATE="openai/gpt-oss-120b"
AI_TIMEOUT_MS=12000
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL_GUARD="openai/gpt-oss-20b"
AI_MODEL_TESTGEN="openai/gpt-oss-120b"
AI_MODEL_DEBATE="openai/gpt-oss-120b"

# -----------------------------------------------------------------------------
# AI — Google Gemini (Free tier)
# https://aistudio.google.com/apikey
# -----------------------------------------------------------------------------
GOOGLE_GENERATIVE_AI_API_KEY=""

# -----------------------------------------------------------------------------
# STORAGE — AWS S3 / Supabase Storage
# For file attachments in chat (presigned URLs)
# -----------------------------------------------------------------------------
# Option A: AWS S3
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-southeast-1"
AWS_S3_BUCKET=""

# Option B: Supabase Storage via its S3 protocol (Storage → Settings → S3 access keys)
# Reuse the AWS_* variables above with the Supabase values, plus:
# S3_ENDPOINT="https://<project-ref>.supabase.co/storage/v1/s3"
# S3_FORCE_PATH_STYLE="true"
# AWS_REGION = the project region shown next to the endpoint, e.g. "ap-southeast-1"
# AWS_S3_BUCKET = a PRIVATE bucket name, e.g. "attachments"

# -----------------------------------------------------------------------------
# BLOCKCHAIN — Base Sepolia USDC escrow
# -----------------------------------------------------------------------------
# RPC URL — Alchemy (recommended)
# https://dashboard.alchemy.com/
BASE_SEPOLIA_RPC_URL=""   # Base Sepolia: https://base-sepolia.g.alchemy.com/v2/<key>

# Deployer private key (NEVER commit the real key!)
DEPLOYER_PRIVATE_KEY=""
USDC_ADDRESS="" # Defaults to official USDC on Base Sepolia, or MockUSDC locally
OWNER_SAFE=""
ARBITER_SAFE=""
FEE_RECIPIENT=""
ALLOW_BASE_SEPOLIA_DEPLOYMENT="false"

# Deployed contract addresses (filled after deployment)
ESCROW_CONTRACT_ADDRESS_BASE_SEPOLIA=""    # filled after: bun run deploy:base-sepolia
ESCROW_CHAIN_ID="84532"
ESCROW_MIN_CONFIRMATIONS="3"
# For local testing, override all three together:
# ESCROW_RPC_URL="http://127.0.0.1:8545"
# ESCROW_CONTRACT_ADDRESS="<local deployed address>"
# ESCROW_CHAIN_ID="31337"

# Etherscan / Basescan API key for contract verification
# https://etherscan.io/myapikey | https://basescan.org/myapikey
BASESCAN_API_KEY=""

# -----------------------------------------------------------------------------
# GITHUB OAUTH — For KYC / verified badge
# https://github.com/settings/developers
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:4000/api/auth/github/callback"
# Random 32-byte key encoded as 64 hex characters; encrypts stored OAuth tokens.
GITHUB_TOKEN_ENCRYPTION_KEY=""

# GitHub App — For webhook (PR merged → auto-payment)
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""

# -----------------------------------------------------------------------------
# APP
# -----------------------------------------------------------------------------
NODE_ENV="development"
PORT=4000
NEXT_PUBLIC_APP_URL="http://localhost:4000"
NEXT_PUBLIC_THIRDWEB_CLIENT_ID="${THIRDWEB_CLIENT_ID}"
# Comma-separated wallets promoted to ADMIN on sign-in (e.g. "0xabc...,0xdef...")
ADMIN_WALLETS=""
# Optional: interface to bind (defaults to 0.0.0.0 in production, localhost in dev)
# BIND_HOST="0.0.0.0"

# Logging level: trace | debug | info | warn | error | fatal
LOG_LEVEL="info"

# -----------------------------------------------------------------------------
# MONITORING — Sentry (Sprint 4)
# https://sentry.io
# -----------------------------------------------------------------------------
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""

# -----------------------------------------------------------------------------
# WORKER — indexer and reconciler (apps/worker, run with `bun run worker:start`)
# Local Hardhat: RPC_URL=http://127.0.0.1:8545, CHAIN_ID=31337
# -----------------------------------------------------------------------------
# JSON-RPC endpoint the indexer reads (must support the "safe" block tag)
RPC_URL=""
CHAIN_ID=""
# Escrow contract to index, and the block it was deployed at (scan starts there)
ESCROW_ADDRESS=""
ESCROW_DEPLOY_BLOCK=""
# Health endpoint port (GET /health returns 503 when unhealthy)
# WORKER_PORT="4300"
# Max blocks per eth_getLogs call; halved automatically when the RPC refuses a range
# INDEXER_RANGE_SIZE="2000"
# How far back a reorg rewinds the cursor
# INDEXER_REORG_WINDOW="64"
# Optional: receives JSON alerts (projection lag > 5 min, 5+ RPC errors in a row)
# ALERT_WEBHOOK_URL=""
# DIRECT_URL (already above) is used for the advisory lock and LISTEN; it must not be a pooled URL.
