{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["contracts", "test", "scripts", "hardhat.config.ts", "typechain-types"],
  "exclude": ["node_modules", "artifacts", "cache"]
}
