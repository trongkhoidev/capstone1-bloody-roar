// =============================================================================
// Bloody-Roar — Prisma Schema (v2 · escrow projection)
// Stack: PostgreSQL + Prisma ORM
// v2: the chain is the source of truth for escrow state. ChainEvent and
// EscrowProjection mirror it. Legacy Escrow/Transaction and the legacy enum
// values marked "legacy" stay until BE-41-final removes them.
// Run: bun run db:migrate (local) | bun run db:migrate:prod (production)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

generator pothos {
  provider     = "prisma-pothos-types"
  clientOutput = "@prisma/client"
  output       = "../../../apps/web/src/graphql/generated/pothos-types.ts"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  CLIENT // Can post bounties
  DEVELOPER // Can apply for bounties
  ADMIN // Platform admin / arbiter
}

enum IssueStatus {
  OPEN // Accepting applications
  AWAITING_FUNDING // Developer selected, reservation open until funded or expired
  IN_PROGRESS // Developer assigned, work started
  COMPLETED // Resolution allocated developer funds; claims are separate
  CANCELLED // Cancelled by client (before assignment)
  DISPUTED // Dispute raised, funds frozen
}

enum IssueCategory {
  BUG_FIX
  FEATURE
  SMART_CONTRACT
  AUDIT
  UI_UX
  DATA_SCIENCE
  DEVOPS
  DOCUMENTATION
  OTHER
}

enum ApplicationStatus {
  PENDING // Applied, awaiting client review
  ACCEPTED // Client selected this developer
  REJECTED // Client chose another developer
  WITHDRAWN // Developer withdrew their application
}

enum EscrowStatus {
  AWAITING_DELIVERY // Funds locked, dev working
  COMPLETED // Funds allocated; recipient claims are separate
  CANCELLED // Full client refund allocated
  DISPUTED // Dispute raised, funds frozen
  RESOLUTION_PROPOSED // Legacy business status; use EscrowPhase for ruling state
}

enum EscrowPhase {
  NONE
  FUNDED
  DISPUTED
  INITIAL_RULING
  CHALLENGED
  FINAL_RULING
  RESOLVED
}

enum EscrowResolutionKind {
  NONE
  RELEASE
  MISSED_DELIVERY_REFUND
  REVIEW_TIMEOUT
  SETTLEMENT
  RULING
  ARBITER_TIMEOUT_SPLIT
}

enum DisputeStatus {
  OPEN // Dispute raised, under investigation
  ANALYZING // AI analyzing evidence
  PROPOSED // Resolution proposed by arbiter
  RESOLVED // Resolution executed on-chain
  CHALLENGED // Resolution challenged during 7-day window
  FINAL_RULING // Final decision posted, in 24h notice period
}

enum NotificationType {
  NEW_APPLICANT // Client: someone applied to your task
  APPLICATION_ACCEPTED // Dev: your application was accepted
  APPLICATION_REJECTED // Dev: your application was rejected
  TASK_ASSIGNED // Dev: you were assigned to a task
  PAYMENT_RECEIVED // Dev: payment released
  DISPUTE_RAISED // Both: dispute was raised
  DISPUTE_RESOLVED // Both: dispute was resolved
  MESSAGE_RECEIVED // New chat message
  // v2 (BE-61): emitted by the worker from chain events, deduped by dedupeKey
  FUNDING_REQUIRED
  RESERVATION_EXPIRED
  DEPOSIT_CONFIRMED
  WORK_SUBMITTED
  CHANGES_REQUESTED
  SETTLEMENT_PROPOSED
  SETTLEMENT_REVOKED
  EVIDENCE_SUBMITTED
  RULING_POSTED
  RULING_CHALLENGED
  ESCROW_RESOLVED
  FUNDS_CLAIMABLE
  DEADLINE_APPROACHING
}

enum MessageType {
  TEXT
  FILE
  SYSTEM // System messages (e.g., "Task assigned")
}

enum TransactionType {
  DEPOSIT
  RELEASE
  CANCEL
  DISPUTE
  RESOLVE
  WORK
  SETTLEMENT
  EVIDENCE
  RULING
  CHALLENGE
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum SubmissionStatus {
  SUBMITTED
  DRAFT // v2: off-chain draft before the delivery hash is computed
  PENDING_CHAIN // v2: submitWork sent, waiting for the chain event
  SUPERSEDED // v2: replaced by a newer submission before the deadline
  UNDER_REVIEW // legacy, removed in BE-41-final; data mapped to SUBMITTED
  APPROVED // legacy, removed in BE-41-final; data mapped to SUBMITTED
  REJECTED // legacy, removed in BE-41-final; data mapped to SUBMITTED + changesRequested
}

// v2 enums ------------------------------------------------------------------

enum ReservationStatus {
  AWAITING_FUNDING
  FUNDED
  EXPIRED
  CANCELLED
  MISMATCHED // Deposit arrived but terms differ from the reservation (QĐ-17)
}

enum IntentStatus {
  AWAITING_SIGNATURE
  SUBMITTED
  PENDING_SAFE_HEAD
  CONFIRMED // Set only by the applier after the event is folded, never from a receipt
  FAILED
  EXPIRED
  DROPPED
}

enum AttachmentPurpose {
  CHAT
  ISSUE_IMAGE
  DELIVERY
  EVIDENCE
  AVATAR
}

enum AttachmentStatus {
  PENDING
  ATTACHED
}

enum AttestationType {
  COMPLETION // Task completed
  SKILL // Skill certification
  CERTIFICATION // Other certificate
}

enum TestCasePriority {
  CRITICAL
  NORMAL
  LOW
}

enum TestCaseSource {
  AI // Generated by AI Test Generator
  MANUAL // Written by client
}

enum PRState {
  OPEN // PR opened, awaiting review
  MERGED // PR merged into target branch
  CLOSED // PR closed without merging
}

enum AILogStatus {
  SUCCESS
  ERROR
  FALLBACK // Primary model failed, fallback model used
}

// =============================================================================
// MODELS
// =============================================================================

// User — Client / Developer / Admin
model User {
  id            String   @id @default(cuid())
  walletAddress String   @unique // EVM address (checksummed)
  role          UserRole @default(DEVELOPER)

  // Profile
  name     String?
  email    String?  @unique
  avatar   String? // URL to avatar image (S3 / IPFS)
  bio      String?
  skills   String[] // Array of skill tags
  location String?

  // GitHub KYC (Sprint 3)
  githubUsername             String? @unique
  githubId                   String? @unique
  githubAccessTokenEncrypted String? // Encrypted OAuth token for GitHub API calls
  isGithubVerified           Boolean @default(false)

  // Reputation
  reputationScore    Float  @default(0) // Off-chain aggregate (from Review)
  completedTaskCount Int    @default(0)
  passportScore      Float? // Gitcoin Passport score (anti-Sybil, v2)

  // Platform admin flags
  isBanned     Boolean   @default(false)
  bannedReason String?
  bannedAt     DateTime?

  // Activity
  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  postedIssues     Issue[]        @relation("ClientIssues")
  applications     Application[]
  assignedIssues   Issue[]        @relation("DeveloperIssues")
  sentMessages     Message[]
  notifications    Notification[]
  escrowsAsClient  Escrow[]       @relation("ClientEscrows")
  escrowsAsDev     Escrow[]       @relation("DeveloperEscrows")
  raisedDisputes   Dispute[]      @relation("DisputeRaiser")
  resolvedDisputes Dispute[]      @relation("DisputeResolver")
  sessions         Session[]
  uploads          Attachment[]
  reviewsGiven     Review[]       @relation("ReviewClient")
  reviewsReceived  Review[]       @relation("ReviewDeveloper")
  submissions      Submission[]
  attestations     Attestation[]
  issueComments    IssueComment[]

  @@index([walletAddress])
  @@index([githubId])
  @@map("users")
}

// Token — whitelisted ERC-20 tokens accepted for bounties
model Token {
  id        String  @id @default(cuid())
  symbol    String // "USDT", "USDC", "DAI"
  name      String // "Tether USD"
  address   String // ERC-20 contract address
  decimals  Int // 6 (USDT/USDC), 18 (DAI/ETH)
  chainId   Int
  isActive  Boolean @default(true) // Whitelist on/off
  isNative  Boolean @default(false)
  sortOrder Int     @default(0) // Display order
  logoUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issues  Issue[]
  escrows Escrow[]

  @@unique([chainId, address])
  @@index([isActive])
  @@map("tokens")
}

// Session — auth session (refresh token + SIWE nonce)
model Session {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash String    @unique // Hash of refresh token (never store raw)
  nonce       String?   @unique // SIWE nonce (replay protection)
  userAgent   String?
  ip          String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@map("sessions")
}

// One-time SIWE challenge issued by the server. The raw nonce is never stored.
model AuthChallenge {
  id            String    @id @default(cuid())
  nonceHash     String    @unique
  walletAddress String
  domain        String
  uri           String
  chainId       Int
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([expiresAt])
  @@map("auth_challenges")
}

// Issue — a bounty task posted by a Client
model Issue {
  id          String        @id @default(cuid())
  title       String
  description String // Markdown content
  category    IssueCategory
  status      IssueStatus   @default(OPEN)

  // Bounty info (multi-token)
  bountyAmount Decimal @db.Decimal(20, 6) // Human-readable units (convert to raw via token.decimals)
  tokenId      String
  token        Token   @relation(fields: [tokenId], references: [id])

  // Client EIP-712 off-chain commitment (Sprint 2)
  commitmentSignature String?
  commitmentNonce     String?
  commitmentExpiresAt DateTime? // Signature expiry

  // Skills/tech required
  requiredSkills String[]
  difficulty     String? // "Easy" | "Medium" | "Hard"
  timeEstimate   String? // e.g., "2-3 days"

  // Lifecycle / publishing
  expiresAt   DateTime? // Application deadline (BE-14)
  isDraft     Boolean   @default(false) // Draft before publish
  publishedAt DateTime?
  viewCount   Int       @default(0) // Analytics

  // Escrow terms (v2, BE-14 / QĐ-23)
  deliveryDeadline DateTime?
  termsVersion     Int                   @default(1)
  termsHash        String?
  outcome          EscrowResolutionKind? // Copied from the projection when the escrow resolves

  // GitHub repo link (Sprint 3)
  githubRepo           String?
  githubInstallationId String?

  // Relations
  clientId     String
  client       User          @relation("ClientIssues", fields: [clientId], references: [id])
  developerId  String?
  developer    User?         @relation("DeveloperIssues", fields: [developerId], references: [id])
  applications Application[]
  messages     Message[]
  attachments  Attachment[]
  escrow       Escrow?
  dispute      Dispute?
  testCases    TestCase[]
  submissions  Submission[]
  review       Review?
  comments     IssueComment[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  assignedAt  DateTime?
  completedAt DateTime?

  @@index([status])
  @@index([category])
  @@index([clientId])
  @@index([developerId])
  @@index([tokenId])
  @@map("issues")
}

// Application — a Developer's application to an Issue
model Application {
  id      String            @id @default(cuid())
  status  ApplicationStatus @default(PENDING)
  message String? // Cover letter / pitch

  issueId String
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)

  developerId String
  developer   User   @relation(fields: [developerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([issueId, developerId]) // One application per dev per issue
  @@index([issueId])
  @@index([developerId])
  @@map("applications")
}

// Escrow — on-chain escrow state mirrored in DB
model Escrow {
  id     String       @id @default(cuid())
  status EscrowStatus @default(AWAITING_DELIVERY)
  phase EscrowPhase @default(FUNDED)
  resolutionKind EscrowResolutionKind @default(NONE)

  // On-chain data
  txHashDeposit   String? // Transaction hash for deposit
  txHashRelease   String? // Transaction hash for release
  txHashCancel    String? // Transaction hash for cancel
  contractAddress String? // Escrow contract address
  onChainIssueId  String? // issueId as stored on-chain

  // Token + fee snapshot (audit)
  tokenId        String
  token          Token   @relation(fields: [tokenId], references: [id])
  arbiterAddress String?
  feeRecipientAddress String?
  termsHash String?
  deliveryHash String?
  settlementProposer String?
  settlementClientBps Int?
  lastChainBlock Int?
  lastChainTransactionIndex Int?
  lastChainLogIndex Int?
  platformFeeBps Int     @default(250) // 2.5% in basis points, snapshot at deposit

  // Amounts (human-readable, mirror of on-chain state)
  bountyAmount      Decimal
  platformFeeAmount Decimal @default(0)
  developerPayout   Decimal @default(0)
  clientRefund      Decimal @default(0)

  // Timelock info
  depositedAt    DateTime?
  releasedAt     DateTime?
  timeoutClaimAt DateTime? // Deprecated alias of reviewDeadline
  deliveryDeadline DateTime?
  reviewDeadline DateTime? // deliveryDeadline + 7 days
  resolvedAt DateTime? // Allocation recorded; recipients still need claim(address)

  issueId     String @unique
  issue       Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  clientId    String
  client      User   @relation("ClientEscrows", fields: [clientId], references: [id])
  developerId String
  developer   User   @relation("DeveloperEscrows", fields: [developerId], references: [id])

  transactions Transaction[]
  dispute      Dispute?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([issueId])
  @@index([clientId])
  @@index([developerId])
  @@index([tokenId])
  @@map("escrows")
}

// Transaction — blockchain transaction log
model Transaction {
  id          String            @id @default(cuid())
  txHash      String
  logIndex    Int               @default(0)
  type        TransactionType
  status      TransactionStatus @default(PENDING)
  from        String? // Sender address (audit)
  to          String? // Recipient address (audit)
  blockNumber Int?
  blockHash   String?
  confirmations Int?
  gasUsed     BigInt? // Raw gas units
  gasPrice    BigInt? // wei
  chainId     Int

  escrowId String
  escrow   Escrow @relation(fields: [escrowId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([escrowId])
  @@index([txHash])
  @@unique([chainId, to, txHash, logIndex])
  @@map("transactions")
}

// Message — chat message between Client and Developer in a task (per room)
model Message {
  id           String      @id @default(cuid())
  content      String // Text content (may be masked by AI Guard)
  type         MessageType @default(TEXT)
  wasModified  Boolean     @default(false) // AI Guard changed this message
  originalHash String? // Hash of original content (for audit)

  issueId  String
  issue    Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  senderId String
  sender   User   @relation(fields: [senderId], references: [id])

  // Real-world chat concerns
  clientMessageId String? // Idempotency key (dedupe retries)
  replyToId       String? // Reply to a specific message
  readAt          DateTime? // Read receipt (unread count)
  editedAt        DateTime? // Edited marker
  isDeleted       Boolean   @default(false) // Soft delete
  deletedAt       DateTime?
  afterDispute    Boolean   @default(false) // Sent after a dispute was raised (QĐ-24)

  createdAt   DateTime     @default(now())
  attachments Attachment[]

  @@index([issueId, createdAt]) // Load lịch sử chat theo room + đúng thứ tự
  @@index([senderId])
  @@index([clientMessageId])
  @@map("messages")
}

// Attachment — file attached to an Issue (screenshots) or a Message (chat file)
model Attachment {
  id         String   @id @default(cuid())
  issueId    String?
  issue      Issue?   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  messageId  String?
  message    Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploaderId String
  uploader   User     @relation(fields: [uploaderId], references: [id])
  fileName   String
  fileUrl    String // S3 key or URL
  fileSize   Int
  fileMime   String
  etag       String? // S3 ETag (integrity check)
  purpose    AttachmentPurpose?
  sha256     String? // Checked against the client value after upload (QĐ-28)
  status     AttachmentStatus @default(PENDING)
  createdAt  DateTime @default(now())

  @@index([issueId])
  @@index([messageId])
  @@index([uploaderId])
  @@map("attachments")
}

// Dispute — a formal dispute raised by Client or Developer
model Dispute {
  id     String        @id @default(cuid())
  status DisputeStatus @default(OPEN)
  reason String // Why the dispute was raised

  // AI analysis results (Sprint 3)
  aiReport          Json? // Full AI debate result
  suggestedRatio    Decimal? // Suggested client payout ratio (0-100)
  aiConfidenceScore Float? // AI confidence in the verdict

  // Resolution details
  proposedClientRatio Decimal? // Arbiter's proposed ratio
  finalClientRatio    Decimal? // Client percentage of resolved principal allocation
  proposedAt          DateTime? // When arbiter proposed
  challengeDeadline   DateTime? // Initial ruling + 7 days
  evidenceManifestHash String?
  counterpartyEvidenceHash String?
  evidenceResponseDeadline DateTime?
  arbiterTimeoutAt DateTime?
  initialDecisionHash String?
  finalDecisionHash String?
  finalRulingAt DateTime?
  noticeDeadline DateTime? // Final ruling + 24h
  resolvedAt          DateTime?

  // Challenge tracking
  challengedById String?
  challengedAt   DateTime?
  resolutionNote String? // Arbiter reasoning

  // v2 (BE-51): the *Decimal columns above are legacy; bps is the new unit
  phase              EscrowPhase?
  suggestedClientBps Int?
  proposedClientBps  Int?
  finalClientBps     Int?
  aiStatus           String? // AI analysis state, kept apart from DisputeStatus

  issueId      String  @unique
  issue        Issue   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  escrowId     String? @unique
  escrow       Escrow? @relation(fields: [escrowId], references: [id], onDelete: Cascade)
  raisedById   String
  raisedBy     User    @relation("DisputeRaiser", fields: [raisedById], references: [id])
  resolvedById String?
  resolvedBy   User?   @relation("DisputeResolver", fields: [resolvedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([issueId])
  @@index([escrowId])
  @@map("disputes")
}

// TestCase — AI-generated test cases / acceptance criteria for an Issue (Sprint 2)
model TestCase {
  id          String  @id @default(cuid())
  title       String
  description String
  given       String // BDD: Given
  when        String // BDD: When
  then        String // BDD: Then
  isEdgeCase  Boolean          @default(false)
  priority    TestCasePriority @default(NORMAL)
  source      TestCaseSource? // AI-generated or manually written

  // Client review
  isApproved  Boolean @default(false)
  clientNotes String?

  issueId String
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([issueId])
  @@map("test_cases")
}

// Submission — a developer's work delivery / PR (Sprint 3 GitHub integration)
model Submission {
  id             String           @id @default(cuid())
  issueId        String
  issue          Issue            @relation(fields: [issueId], references: [id], onDelete: Cascade)
  developerId    String
  developer      User             @relation(fields: [developerId], references: [id])
  description    String?
  pullRequestUrl String?
  prNumber       Int? // GitHub PR number (webhook)
  prState        PRState? // open / merged / closed
  commitSha      String?
  status         SubmissionStatus @default(SUBMITTED)
  submittedAt    DateTime         @default(now())
  mergedAt       DateTime? // When PR merged
  reviewedAt     DateTime?
  reviewNotes    String?

  // v2 (BE-39)
  deliveryHash     String?   @unique // keccak256 of the RFC 8785 manifest
  manifest         Json?
  supersededAt     DateTime?
  onChainEventId   String?
  changesRequested Boolean   @default(false)

  @@index([issueId])
  @@index([developerId])
  @@map("submissions")
}

// Review — client rating of a completed task (feeds reputation)
model Review {
  id          String   @id @default(cuid())
  issueId     String   @unique // 1 issue = 1 review
  issue       Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  clientId    String
  client      User     @relation("ReviewClient", fields: [clientId], references: [id])
  developerId String
  developer   User     @relation("ReviewDeveloper", fields: [developerId], references: [id])
  rating      Int // 1-5 stars
  comment     String?
  createdAt   DateTime @default(now())

  @@index([developerId])
  @@map("reviews")
}

// IssueComment — public discussion and clarifying questions on a bounty
model IssueComment {
  id        String   @id @default(cuid())
  body      String
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([issueId, createdAt])
  @@index([userId])
  @@map("issue_comments")
}

// Attestation — EAS on-chain reputation/certificate (v1.5)
model Attestation {
  id             String          @id @default(cuid())
  attestationUid String          @unique // EAS attestation UID
  schemaUid      String // EAS schema UID
  developerId    String
  developer      User            @relation(fields: [developerId], references: [id])
  issueId        String? // Related task (nullable for standalone certs)
  reviewId       String?
  type           AttestationType @default(COMPLETION)
  data           Json // { completedTask, rating, skills }
  chainId        Int
  attester       String // Address that signed the attestation (platform)
  revokedAt      DateTime?
  createdAt      DateTime        @default(now())

  @@index([developerId])
  @@index([issueId])
  @@map("attestations")
}

// AILog — audit log for every AI call (cost + latency tracking)
model AILog {
  id               String   @id @default(cuid())
  task             String // GUARD | TESTGEN | DEBATE | ...
  model            String // llama-3.1-8b, gpt-oss-120b...
  provider         String // groq | gemini | openai
  issueId          String?
  disputeId        String?
  latencyMs        Int?
  promptTokens     Int?
  completionTokens Int?
  costUsd          Decimal?
  inputHash        String? // Hash of input (never raw)
  outputHash       String?
  status           AILogStatus @default(SUCCESS)
  errorMessage     String?
  createdAt        DateTime @default(now())

  @@index([task])
  @@index([issueId])
  @@index([createdAt])
  @@map("ai_logs")
}

// Notification — real-time notifications (Sprint 3)
model Notification {
  id      String           @id @default(cuid())
  type    NotificationType
  title   String
  body    String
  isRead  Boolean          @default(false)
  data    Json? // Extra payload (e.g., { issueId, applicationId })
  actorId  String? // Who triggered the notification (for display)
  link     String? // Deep link to relevant page
  dedupeKey String? @unique // Idempotency key, e.g. chainEventId:userId (QĐ-27)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// AdminLog — audit log for admin actions
model AdminLog {
  id        String   @id @default(cuid())
  action    String // e.g., "ban_user" | "resolve_dispute" | "propose_resolution"
  target    String // Target entity type ("user" | "issue" | "dispute")
  targetId  String
  details   Json?
  adminId   String // Admin user ID (wallet address)
  createdAt DateTime @default(now())

  @@index([adminId])
  @@map("admin_logs")
}

// =============================================================================
// ESCROW PROJECTION (v2) — the chain is the source of truth; these mirror it.
// Ids are off-chain references (scalars, no relation fields) so the indexer can
// write before the issue row exists and replays never hit FK cascades.
// =============================================================================

// FundingReservation — a 24h hold from selecting a developer until deposit.
// Migration 20261027120000 adds a partial unique index (not in this file): one
// AWAITING_FUNDING/FUNDED row per issue.
model FundingReservation {
  id               String            @id @default(cuid())
  issueId          String
  applicationId    String
  clientId         String
  developerId      String
  escrowKey        String            @unique // string passed to deposit(), br_<issueId>_<n>
  escrowIdHash     String            @unique // keccak256(utf8(escrowKey)), the topic in events
  chainId          Int
  contractAddress  String
  tokenAddress     String
  amountRaw        Decimal           @db.Decimal(78, 0)
  deliveryDeadline DateTime
  termsHash        String
  termsVersion     Int
  intentSignature  String?
  intentNonce      String?           @unique
  intentExpiresAt  DateTime?
  status           ReservationStatus @default(AWAITING_FUNDING)
  expiresAt        DateTime // now + 24h
  fundedAt         DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([issueId, status])
  @@map("funding_reservations")
}

// TransactionIntent — what the frontend is asked to sign, and its state after.
// Only the indexer/reconciler sets CONFIRMED or FAILED.
model TransactionIntent {
  id                 String       @id @default(cuid())
  userId             String
  issueId            String?
  escrowKey          String?
  chainId            Int
  contractAddress    String
  method             String
  args               Json // decimal strings only
  status             IntentStatus @default(AWAITING_SIGNATURE)
  txHash             String?      @unique
  submittedAt        DateTime?
  expiresAt          DateTime
  failureReason      String?
  confirmedByEventId String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([userId])
  @@index([status])
  @@map("transaction_intents")
}

// ChainEvent — every decoded escrow log. Replays re-read these rows.
model ChainEvent {
  id               String    @id @default(cuid())
  chainId          Int
  contractAddress  String
  txHash           String
  logIndex         Int
  blockNumber      BigInt
  blockHash        String
  txIndex          Int
  eventName        String
  args             Json
  decoderVersion   Int
  escrowIdHash     String?
  canonical        Boolean   @default(true) // false after a reorg removed its block
  firstSeenAt      DateTime  @default(now())
  lastReconciledAt DateTime?

  @@unique([chainId, contractAddress, txHash, logIndex])
  @@index([escrowIdHash, blockNumber, txIndex, logIndex])
  @@map("chain_events")
}

// ProjectionCheckpoint — indexer cursor per contract.
model ProjectionCheckpoint {
  chainId                Int
  contractAddress        String
  lastScannedBlock       BigInt
  lastSafeBlock          BigInt
  lastCanonicalBlockHash String
  decoderVersion         Int
  replayStatus           String
  updatedAt              DateTime @updatedAt

  @@id([chainId, contractAddress])
  @@map("projection_checkpoints")
}

// EscrowProjection — current state of one escrow, folded from ChainEvent.
model EscrowProjection {
  id                       String               @id @default(cuid())
  escrowIdHash             String               @unique
  escrowKey                String?
  issueId                  String?              @unique
  reservationId            String?              @unique
  chainId                  Int
  contractAddress          String
  client                   String
  developer                String
  arbiter                  String
  feeRecipient             String
  amountRaw                Decimal              @db.Decimal(78, 0)
  depositedAt              DateTime
  deliveryDeadline         DateTime
  reviewDeadline           DateTime // deliveryDeadline + 7 days
  termsHash                String
  deliveryHash             String?
  phase                    EscrowPhase
  resolutionKind           EscrowResolutionKind @default(NONE)
  clientAmountRaw          Decimal?             @db.Decimal(78, 0)
  developerAmountRaw       Decimal?             @db.Decimal(78, 0)
  platformFeeRaw           Decimal?             @db.Decimal(78, 0)
  decisionHash             String?
  settlementProposer       String?
  settlementClientBps      Int?
  disputeRaisedBy          String?
  disputeRaisedAt          DateTime?
  raiserEvidenceHash       String?
  counterpartyEvidenceHash String?
  challengedAt             DateTime?
  orphan                   Boolean              @default(false) // deposit did not go through the backend (QĐ-05)
  projectionVersion        Int                  @default(0)
  lastProjectedBlock       BigInt
  updatedAt                DateTime             @updatedAt

  @@index([phase])
  @@map("escrow_projections")
}

// RulingRecord — one row per INITIAL or FINAL ruling posted on chain.
model RulingRecord {
  id           String   @id @default(cuid())
  escrowIdHash String
  kind         String // INITIAL | FINAL
  clientBps    Int
  decisionHash String
  arbiter      String
  postedAt     DateTime
  noticeEndsAt DateTime
  chainEventId String   @unique

  @@index([escrowIdHash])
  @@map("ruling_records")
}

// SettlementProposal — a proposed split, until revoked, accepted or voided.
model SettlementProposal {
  id              String  @id @default(cuid())
  escrowIdHash    String
  proposer        String
  clientBps       Int
  status          String // PENDING | REVOKED | ACCEPTED | VOIDED
  proposedEventId String  @unique
  closedEventId   String?

  @@index([escrowIdHash])
  @@map("settlement_proposals")
}

// ClaimableBalance — pull-payment balance per recipient (QĐ-04).
model ClaimableBalance {
  chainId         Int
  contractAddress String
  address         String
  amountRaw       Decimal  @db.Decimal(78, 0)
  updatedAt       DateTime @updatedAt

  @@id([chainId, contractAddress, address])
  @@map("claimable_balances")
}

// ContractConfig — owner, arbiter, fee recipient and pause state, per contract.
model ContractConfig {
  chainId             Int
  contractAddress     String
  paused              Boolean
  owner               String
  pendingOwner        String?
  arbiter             String
  pendingArbiter      String?
  feeRecipient        String
  pendingFeeRecipient String?
  updatedAt           DateTime @updatedAt

  @@id([chainId, contractAddress])
  @@map("contract_configs")
}

// EvidenceManifest — evidence a party submitted for a dispute, hash-anchored on chain.
model EvidenceManifest {
  id             String   @id @default(cuid())
  disputeId      String
  submittedById  String
  manifest       Json
  manifestHash   String   @unique
  storageKey     String
  onChainEventId String?
  createdAt      DateTime @default(now())

  @@index([disputeId])
  @@map("evidence_manifests")
}

// ReconciliationFinding — chain vs projection mismatch; closed when they match again.
model ReconciliationFinding {
  id           String    @id @default(cuid())
  escrowIdHash String?
  kind         String
  expected     Json
  actual       Json
  blockNumber  BigInt
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([escrowIdHash, resolvedAt])
  @@map("reconciliation_findings")
}

// GithubWebhookDelivery — X-GitHub-Delivery ids already handled (BE-69 dedupe).
model GithubWebhookDelivery {
  deliveryId String   @id
  receivedAt DateTime @default(now())

  @@map("github_webhook_deliveries")
}
