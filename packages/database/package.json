{
  "name": "@bloody-roar/database",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "db:generate": "POTHOS_OUTPUT=\"${PWD}/../../apps/web/src/graphql/generated/pothos-types.ts\" prisma generate",
    "db:migrate": "POTHOS_OUTPUT=\"${PWD}/../../apps/web/src/graphql/generated/pothos-types.ts\" prisma migrate dev",
    "db:migrate:prod": "POTHOS_OUTPUT=\"${PWD}/../../apps/web/src/graphql/generated/pothos-types.ts\" prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "bun run src/seed.ts",
    "db:push": "POTHOS_OUTPUT=\"${PWD}/../../apps/web/src/graphql/generated/pothos-types.ts\" prisma db push",
    "db:reset": "POTHOS_OUTPUT=\"${PWD}/../../apps/web/src/graphql/generated/pothos-types.ts\" prisma migrate reset"
  },
  "dependencies": {
    "@prisma/client": "^5.16.0"
  },
  "devDependencies": {
    "@pothos/plugin-prisma": "^4.15.0",
    "prisma": "^5.16.0"
  },
  "exports": {
    ".": "./src/index.ts"
  }
}